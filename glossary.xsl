<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:param name="q" select="''"/><xsl:param name="category" select="''"/><xsl:param name="sort" select="'title'"/><xsl:param name="asset-root" select="''"/>
<xsl:variable name="upper" select="'ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ'"/>
<xsl:variable name="lower" select="'abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя'"/>
<xsl:template match="/glossary"><html lang="ru"><head><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Справочник игровых терминов</title><link rel="stylesheet" href="{$asset-root}css/style.css?v=20261108-1"/></head><body class="xml-frame"><xsl:variable name="rows" select="term[($category='' or category=$category) and ($q='' or contains(translate(concat(title,' ',english),$upper,$lower),$q))]"/><p>Найдено терминов: <strong><xsl:value-of select="count($rows)"/></strong> из 50.</p><div class="table-wrap"><table class="table"><caption>Игровые термины и определения</caption><thead><tr><th>Термин</th><th>Категория</th><th>Определение</th><th>Пример</th><th>Английское название</th><th>Связанный термин</th></tr></thead><tbody><xsl:for-each select="$rows"><xsl:sort select="*[name()=$sort]" lang="ru"/><tr><td><xsl:value-of select="title"/></td><td><xsl:value-of select="category"/></td><td><xsl:value-of select="definition"/></td><td><xsl:value-of select="example"/></td><td><xsl:value-of select="english"/></td><td><xsl:value-of select="related"/></td></tr></xsl:for-each></tbody></table></div><xsl:if test="not($rows)"><p>По заданным условиям терминов нет.</p></xsl:if></body></html></xsl:template></xsl:stylesheet>